{
  "info": {
    "name": "API Citas Médicas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas funcionales de la API de Citas Médicas. Ejecutar con Run collection, en orden, con la API corriendo en http://localhost:5080."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "citaId",
      "value": ""
    },
    {
      "key": "fechaCita",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const f = pm.collectionVariables.get('fechaCita');",
          "if (!f || new Date(f) < new Date()) {",
          "  const d = new Date(Date.now() + 3*24*60*60*1000);",
          "  pm.collectionVariables.set('fechaCita', d.toISOString().substring(0,19));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01. GET Médicos (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/medicos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "medicos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Devuelve 3 médicos', () => pm.expect(pm.response.json()).to.have.lengthOf(3));"
            ]
          }
        }
      ]
    },
