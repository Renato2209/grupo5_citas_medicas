    {
      "name": "06. POST Crear cita (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/citas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "citas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pacienteId\": 1,\n  \"medicoId\": 1,\n  \"fechaHora\": \"{{fechaCita}}\",\n  \"motivo\": \"Control general anual\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Tiene header Location', () => pm.response.to.have.header('Location'));",
              "pm.test('Estado Pendiente', () => pm.expect(pm.response.json().estado).to.eql('Pendiente'));",
              "pm.collectionVariables.set('citaId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
